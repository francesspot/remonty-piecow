---
import Icon from './Icon.astro';
import { company } from '../data/company';
import { content, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];

const mailto = `mailto:${company.email}?subject=${encodeURIComponent(t.emailSubject)}`;
---

<section id="kontakt" class="relative overflow-hidden bg-coal-900 py-20 text-white md:py-28" aria-labelledby="contact-title">
  <div class="absolute -left-24 top-0 size-96 rounded-full bg-ember-600/15 blur-3xl"></div>

  <div class="relative mx-auto max-w-6xl px-5">
    <div class="reveal mb-12 max-w-2xl">
      <h2 id="contact-title" class="text-3xl font-bold md:text-4xl">{t.contact.title}</h2>
      <p class="mt-3 text-lg text-stone-300">
        {t.contact.description}
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <a href={`tel:${company.phone}`} class="reveal group rounded-2xl border border-coal-700 bg-coal-800 p-6 transition hover:border-ember-600">
        <Icon name="phone" class="text-ember-400" />
        <span class="mt-4 block text-sm text-stone-400">{t.contact.phone}</span>
        <strong class="mt-1 block text-xl">{company.phoneDisplay}</strong>
      </a>
      <a href={mailto} class="reveal group rounded-2xl border border-coal-700 bg-coal-800 p-6 transition hover:border-ember-600">
        <Icon name="mail" class="text-ember-400" />
        <span class="mt-4 block text-sm text-stone-400">{t.contact.email}</span>
        <strong class="mt-1 block break-words text-xl">{company.email}</strong>
      </a>
      <div class="reveal rounded-2xl border border-coal-700 bg-coal-800 p-6">
        <Icon name="map" class="text-ember-400" />
        <span class="mt-4 block text-sm text-stone-400">{t.contact.area}</span>
        <strong class="mt-1 block text-xl">{t.contact.areaValue}</strong>
      </div>
    </div>
  </div>
</section>
