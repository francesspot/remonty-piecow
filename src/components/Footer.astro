---
import Icon from './Icon.astro';
import { company } from '../data/company';
import { content, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];

const year = new Date().getFullYear();
---

<footer class="bg-coal-950 py-8 text-sm text-stone-400">
  <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-x-6 gap-y-2 px-5">
    <span>© {year} {company.name} – {t.tagline}</span>
    <a href={`tel:${company.phone}`} class="hover:text-white">Tel. {company.phoneDisplay}</a>
  </div>
</footer>

<!-- Przycisk „Zadzwoń” przyklejony do dołu ekranu na telefonach -->
<a
  href={`tel:${company.phone}`}
  class="fixed inset-x-3 bottom-3 z-40 flex items-center justify-center gap-2 rounded-xl bg-ember-600 py-3.5 font-semibold text-white shadow-xl shadow-black/30 md:hidden"
>
  <Icon name="phone" size={18} />
  {t.call}: {company.phoneDisplay}
</a>
