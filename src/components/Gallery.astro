---
import { Image, getImage } from 'astro:assets';
import { gallery } from '../data/photos';
import { content, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];

// Dla każdego zdjęcia: miniatura w siatce + większa wersja WebP do powiększenia.
const photos = await Promise.all(
  gallery.map(async (photo) => ({
    ...photo,
    alt: photo.description[lang],
    large: (await getImage({ src: photo.src, width: Math.min(photo.src.width, 1800), format: 'webp' })).src,
  })),
);
---

{
  photos.length > 0 && (
    <section id="realizacje" class="border-y border-stone-200 bg-white py-20 md:py-28" aria-labelledby="projects-title">
      <div class="mx-auto max-w-6xl px-5">
        <div class="reveal mb-12 max-w-2xl">
          <h2 id="projects-title" class="text-3xl font-bold md:text-4xl">{t.gallery.title}</h2>
          <p class="mt-3 text-lg text-stone-600">{t.gallery.description}</p>
        </div>

        <!-- Układ kolumnowy (masonry): zdjęcia pionowe i poziome zachowują swoje proporcje -->
        <div class="columns-2 gap-3 md:columns-3 md:gap-4">
          {photos.map((photo) => (
            <button
              type="button"
              class="reveal group relative mb-3 block w-full cursor-zoom-in break-inside-avoid overflow-hidden rounded-xl bg-stone-200 md:mb-4"
              data-large={photo.large}
              data-caption={photo.alt}
            >
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[400, 700]}
                sizes="(min-width: 768px) 33vw, 50vw"
                class="w-full transition duration-500 group-hover:scale-105"
              />
              <span class="pointer-events-none absolute inset-x-0 bottom-0 bg-linear-to-t from-black/70 to-transparent p-3 pt-10 text-left text-sm text-white opacity-0 transition group-hover:opacity-100">
                {photo.alt}
              </span>
            </button>
          ))}
        </div>
      </div>

      <dialog id="lightbox" class="m-auto max-h-[92vh] max-w-[94vw] bg-transparent p-0 backdrop:bg-black/90" aria-label={t.gallery.enlarged}>
        <button type="button" data-close class="fixed right-5 top-3 text-4xl leading-none text-white" aria-label={t.gallery.close}>
          ×
        </button>
        <img src="" alt="" class="mx-auto max-h-[84vh] max-w-[94vw] rounded-md" />
        <p class="mt-3 text-center text-stone-200" />
      </dialog>
    </section>
  )
}

<script>
  // Powiększanie zdjęć w natywnym <dialog>; kliknięcie w tło trafia w sam <dialog> i go zamyka.
  const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (lightbox) {
    const img = lightbox.querySelector('img')!;
    const caption = lightbox.querySelector('p')!;

    document.querySelectorAll<HTMLButtonElement>('[data-large]').forEach((btn) =>
      btn.addEventListener('click', () => {
        img.src = btn.dataset.large!;
        img.alt = btn.dataset.caption ?? '';
        caption.textContent = btn.dataset.caption ?? '';
        lightbox.showModal();
      }),
    );

    lightbox.querySelector('[data-close]')!.addEventListener('click', () => lightbox.close());
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) lightbox.close();
    });
  }
</script>
