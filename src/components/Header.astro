---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import LanguageHint from './LanguageHint.astro';
import logo from '../assets/logo.png';
import { company } from '../data/company';
import { content, langs, paths, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];

const links = [
  { href: '#uslugi', text: t.menu.services },
  { href: '#o-firmie', text: t.menu.about },
  { href: '#realizacje', text: t.menu.projects },
  { href: '#kontakt', text: t.menu.contact },
];
---

<header class="sticky top-0 z-50 bg-coal-900/95 text-white backdrop-blur">
  <!-- W przyklejonym nagłówku, żeby pasek był widoczny także po przewinięciu lub wejściu z linku do sekcji -->
  <LanguageHint lang={lang} />
  <div class="relative mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 md:h-18">
    <a href="#top" class="shrink-0" aria-label={`${company.name} – ${t.menu.home}`}>
      <!-- densities: wersja 2x dla ekranów o wysokiej gęstości pikseli -->
      <Image src={logo} alt={company.name} height={48} densities={[1, 2]} loading="eager" class="h-10 w-auto md:h-12" />
    </a>

    <!-- Menu mobilne przełączane checkboxem – działa bez JavaScriptu -->
    <input type="checkbox" id="menu" class="peer hidden" />
    <label for="menu" class="-mr-2 cursor-pointer p-2 md:hidden" aria-label={t.menu.toggle}>
      <Icon name="menu" size={26} />
    </label>

    <nav
      aria-label={t.menu.navigation}
      class="absolute inset-x-0 top-16 hidden md:top-18 flex-col bg-coal-900 px-5 pb-4 peer-checked:flex
             md:static md:flex md:flex-row md:items-center md:gap-7 md:bg-transparent md:p-0"
    >
      {
        links.map((link) => (
          <a href={link.href} class="border-b border-coal-700 py-3 text-[15px] text-stone-200 hover:text-white md:border-0 md:py-0">
            {link.text}
          </a>
        ))
      }
      <a
        href={`tel:${company.phone}`}
        class="mt-3 inline-flex items-center justify-center gap-2 rounded-lg bg-ember-600 px-4 py-2 text-[15px] font-semibold hover:bg-ember-700 md:mt-0"
      >
        <Icon name="phone" size={16} />
        {company.phoneDisplay}
      </a>
      <!-- Przełącznik języka: na telefonie w rozwijanym menu, na komputerze obok numeru -->
      <div class="flex gap-5 pt-4 md:gap-3 md:pt-0" role="group" aria-label={t.menu.language}>
        {
          langs.map((l) => (
            <a
              href={paths[l]}
              hreflang={l}
              lang={l}
              data-lang-choice
              aria-current={l === lang ? 'page' : undefined}
              class:list={['text-sm font-semibold', l === lang ? 'text-white' : 'text-stone-400 hover:text-white']}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<script>
  // Po kliknięciu pozycji w menu mobilnym menu się zwija.
  const toggle = document.getElementById('menu') as HTMLInputElement | null;
  document.querySelectorAll('nav a').forEach((a) =>
    a.addEventListener('click', () => {
      if (toggle) toggle.checked = false;
    }),
  );
</script>
