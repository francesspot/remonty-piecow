---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { company } from '../data/company';
import { heroPhoto } from '../data/photos';
import { content, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<section class="relative isolate overflow-hidden bg-coal-800 text-white" aria-labelledby="hero-title">
  {
    heroPhoto && (
      <Image
        src={heroPhoto.src}
        alt=""
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        priority
        class="absolute inset-0 -z-10 h-full w-full object-cover"
      />
    )
  }
  <!-- Przyciemnienie zdjęcia, żeby tekst był czytelny -->
  <div class="absolute inset-0 -z-10 bg-linear-to-r from-coal-950/95 via-coal-950/80 to-coal-950/40"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-1 bg-linear-to-r from-ember-600 via-ember-400 to-transparent"></div>

  <div class="mx-auto max-w-6xl px-5 pb-24 pt-20 md:pb-32 md:pt-28">
    <p class="mb-4 text-sm font-semibold uppercase tracking-[0.12em] text-ember-300">{t.hero.eyebrow}</p>
    <h1 id="hero-title" class="max-w-3xl text-4xl font-bold leading-[1.05] sm:text-5xl md:text-6xl">
      {t.hero.title}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-stone-200 md:text-xl">
      {t.hero.description}
    </p>

    <div class="mt-9 flex flex-wrap gap-3">
      <a
        href={`tel:${company.phone}`}
        class="inline-flex items-center gap-2 rounded-lg bg-ember-600 px-6 py-3.5 font-semibold shadow-lg shadow-ember-600/25 transition hover:bg-ember-700"
      >
        <Icon name="phone" size={18} />
        {t.call}: {company.phoneDisplay}
      </a>
      <a
        href={`mailto:${company.email}?subject=${encodeURIComponent(t.emailSubject)}`}
        class="inline-flex items-center gap-2 rounded-lg border-2 border-white/50 px-6 py-3 font-semibold transition hover:border-white hover:bg-white/10"
      >
        <Icon name="mail" size={18} />
        {t.write}
      </a>
    </div>

    <ul class="mt-12 flex flex-wrap gap-x-7 gap-y-2 text-[15px] text-stone-300">
      {
        t.hero.facts.map((fact) => (
          <li class="flex items-center gap-2">
            <Icon name="check" size={16} class="text-ember-400" />
            {fact}
          </li>
        ))
      }
    </ul>
  </div>
</section>
