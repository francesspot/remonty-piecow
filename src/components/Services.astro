---
import Icon from './Icon.astro';
import { content, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];

const [featured, ...rest] = t.services.list;
---

<section id="uslugi" class="py-20 md:py-28" aria-labelledby="services-title">
  <div class="mx-auto max-w-6xl px-5">
    <div class="reveal mb-12 max-w-2xl">
      <h2 id="services-title" class="text-3xl font-bold md:text-4xl">{t.services.title}</h2>
      <p class="mt-3 text-lg text-stone-600">
        {t.services.description}
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      <!-- Główna usługa: wyróżniona kafelkiem na dwie kolumny -->
      <article class="reveal relative overflow-hidden rounded-2xl bg-coal-900 p-8 text-white md:col-span-2 md:row-span-2 md:p-10">
        <div class="absolute -right-16 -top-16 size-64 rounded-full bg-ember-600/25 blur-3xl"></div>
        <div class="relative">
          <div class="mb-6 grid size-12 place-items-center rounded-xl bg-ember-600">
            <Icon name={featured.icon} size={26} />
          </div>
          <h3 class="text-2xl font-bold md:text-3xl">{featured.name}</h3>
          <p class="mt-4 max-w-xl text-lg text-stone-300">{featured.description}</p>
          <ul class="mt-8 grid gap-3 text-stone-200 sm:grid-cols-2">
            {
              t.services.highlights.map((highlight) => (
                <li class="flex items-center gap-2">
                  <Icon name="check" size={18} class="text-ember-400" />
                  {highlight}
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      {
        rest.map((service) => (
          <article class="reveal rounded-2xl border border-stone-200 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-stone-200">
            <div class="mb-4 grid size-11 place-items-center rounded-xl bg-ember-50 text-ember-600">
              <Icon name={service.icon} />
            </div>
            <h3 class="text-lg font-bold">{service.name}</h3>
            <p class="mt-2 text-stone-600">{service.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
