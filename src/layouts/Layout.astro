---
import '../styles/global.css';
import { company } from '../data/company';
import { content, langs, paths, type Lang } from '../data/content';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang = 'pl', noindex = false } = Astro.props;
const t = content[lang];
const { title = t.seo.title, description = t.seo.description } = Astro.props;

// Adresy bezwzględne na podstawie `site` z astro.config.mjs.
const canonical = new URL(paths[lang], Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);

// Dane strukturalne schema.org: firma usługowa bez lokalu dla klientów, obsługująca cały kraj.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#firma', Astro.site).href,
  name: `${company.name} – ${t.tagline}`,
  url: Astro.site?.href,
  telephone: company.phone,
  email: company.email,
  image: ogImage.href,
  logo: new URL('/logo.png', Astro.site).href,
  description: t.seo.description,
  areaServed: { '@type': 'Country', name: t.area },
  knowsAbout: [...t.expertise, ...company.brands],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: t.menu.services,
    itemListElement: t.services.list.map((service) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: service.name, description: service.description },
    })),
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="theme-color" content="#1c1917" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <!-- Wersje językowe tej samej strony; x-default = wersja dla pozostałych języków -->
          {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(paths[l], Astro.site)} />)}
          <link rel="alternate" hreflang="x-default" href={new URL(paths.pl, Astro.site)} />
        </>
      )
    }

    <!-- Podgląd linku (Facebook, Messenger, WhatsApp, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.locale} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={content[l].locale} />)}
    <meta property="og:site_name" content={company.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
