---
import Layout from '../layouts/Layout.astro';
import { company } from '../data/company';
import { withBase } from '../utils/base';
---

<Layout title="Nie znaleziono strony | Jerzy Pora" noindex>
  <main class="grid min-h-screen place-items-center bg-coal-900 px-5 text-center text-white">
    <div>
      <p class="font-display text-7xl font-bold text-ember-400">404</p>
      <h1 class="mt-4 text-2xl font-bold">Nie ma takiej strony</h1>
      <p class="mt-2 text-stone-300">Adres mógł się zmienić.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={withBase('/')} class="rounded-lg bg-ember-600 px-5 py-3 font-semibold hover:bg-ember-700">Strona główna</a>
        <a href={`tel:${company.phone}`} class="rounded-lg border-2 border-white/50 px-5 py-2.5 font-semibold hover:bg-white/10">
          Zadzwoń: {company.phoneDisplay}
        </a>
      </div>
    </div>
  </main>
</Layout>
